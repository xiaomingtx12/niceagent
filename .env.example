# Flask基础配置
FLASK_DEBUG=1
FLASK_ENV=development

# Python 警告控制 - 忽略第三方库的弃用警告
PYTHONWARNINGS=ignore::UserWarning:jieba,ignore::ResourceWarning:jieba,ignore::DeprecationWarning

# 服务配置
SERVICE_IP=
SERVICE_API_PREFIX=

# jwt加密秘钥
JWT_SECRET_KEY=your_jwt_secret_key_here

# wtf配置
WTF_CSRF_ENABLED=False

# SQLAlchemy数据库配置
SQLALCHEMY_DATABASE_URI=postgresql://username:password@host:5432/database?client_encoding=utf8
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=3600
SQLALCHEMY_ECHO=True

# DeepAgents runtime
AGENT_CHECKPOINT_BACKEND=postgres
AGENT_MEMORY_BACKEND=postgres
AGENT_SANDBOX_PROVIDER=disabled
AGENT_SANDBOX_SNAPSHOT_ID=
AGENT_SANDBOX_IDLE_TTL_SECONDS=600
AGENT_SANDBOX_DELETE_AFTER_STOP_SECONDS=86400
BUILTIN_SKILLS_ROOT=resources/agent_skills/builtin
WORKSPACE_MAX_BYTES=104857600
WORKSPACE_MAX_FILES=1000

# LangSmith配置
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=your_project_name

# groq
GROQ_API_KEY=your_groq_api_key

# Redis数据库配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_SSL=False
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=2
REDIS_HEALTH_CHECK_INTERVAL=30

# Celery配置
CELERY_BROKER_DB=1
CELERY_RESULT_BACKEND_DB=1
CELERY_TASK_IGNORE_RESULT=False
CELERY_RESULT_EXPIRES=3600
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=True

# 腾讯云COS对象存储
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_REGION=ap-shanghai
COS_SCHEME=https
COS_BUCKET=your_bucket_name
COS_DOMAIN=https://your_bucket_name.cos.ap-shanghai.myqcloud.com

# 腾讯云云函数配置（用于代码执行节点）
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_SCF_REGION=ap-shanghai
TENCENT_SCF_NAMESPACE=default
TENCENT_SCF_FUNCTION_NAME=code-executor

# 高德工具
GAODE_API_KEY=your_gaode_api_key

# 谷歌Serper搜索
SERPER_API_KEY=

# Bing搜索API
BING_SUBSCRIPTION_KEY=
BING_SEARCH_URL=https://api.bing.microsoft.com/v7.0/search

# Searx搜索
SEARX_SEARCH_URL=http://localhost:8888

# Weaviate向量数据库配置
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_SKIP_INIT_CHECKS=True

# Github OAuth应用秘钥
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:5173/auth/authorize/github

# Gitee OAuth应用秘钥
GITEE_CLIENT_ID=your_gitee_client_id
GITEE_CLIENT_SECRET=your_gitee_client_secret
GITEE_REDIRECT_URI=http://localhost:5173/auth/authorize/gitee

# HuggingFace 配置（中国镜像加速）
# 使用 HF-Mirror 镜像站加速模型下载
HF_ENDPOINT=https://hf-mirror.com
# 设置离线模式（0=在线，1=离线）
TRANSFORMERS_OFFLINE=0
# 设置缓存目录
HF_HOME=./internal/core/embeddings
